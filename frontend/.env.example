# Frontend build-time configuration. Copy to frontend/.env (`make env` does this).
# Everything prefixed VITE_ is compiled into the public browser bundle: NEVER put secrets here.

# Origin of the backend API, without a path (the app appends /api/v1 and /health, /ready).
# Leave empty to call the same origin; the Vite dev/preview server then proxies to DEV_PROXY_TARGET.
# For an independently deployed frontend set the backend origin, e.g. https://api.example.org
# (and add the frontend origin to the backend's CORS_ALLOWED_ORIGINS).
VITE_API_BASE_URL=

# --- Dev/preview server only (not exposed to the browser) ---
# Backend origin the Vite dev server proxies /api, /health and /ready to.
DEV_PROXY_TARGET=http://localhost:8000
# Extra Host headers the dev server accepts (comma separated), e.g. a tunnel or preview domain.
DEV_ALLOWED_HOSTS=
