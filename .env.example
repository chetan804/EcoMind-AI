# Docker Compose environment (docker compose reads ./.env). Copy with `make env`, which also
# generates the two secrets below. Never commit .env. Variables for running the backend or
# frontend directly on the host are in backend/.env.example and frontend/.env.example.

# --- PostgreSQL (development container) ---
POSTGRES_DB=ecomind
POSTGRES_USER=ecomind
# Use URL-safe characters only (letters, digits, - _ .): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_local_database_password
# Host port for the database; bound to 127.0.0.1 only.
POSTGRES_PORT=5432

# --- Backend ---
# Signs access tokens; at least 32 characters. `make env` generates one.
SECRET_KEY=CHANGE_ME_generate_a_random_value_with_at_least_32_characters
LOG_LEVEL=INFO
BACKEND_PORT=8000
# Browser origins allowed by CORS (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend ---
FRONTEND_PORT=5173
# Backend origin used by the browser bundle; empty = same origin via the dev-server proxy.
VITE_API_BASE_URL=
# Extra Host headers the dev server accepts (comma separated).
DEV_ALLOWED_HOSTS=

# --- Maps ---
# offline (default: built-in OpenStreetMap-based map, no key) or google (opt-in). Empty = offline,
# or google when the browser key below is set. Tile file: see docs/maps/OFFLINE_MAPS.md.
VITE_MAP_PROVIDER=
VITE_MAP_TILES_URL=

# --- Google Maps (optional provider) ---
# Browser key (Maps JavaScript API) compiled into the bundle: restrict by HTTP referrer and API.
# Empty = no Google maps (the offline map is used). Placeholder only; never commit a real key.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
# Optional road routing (server): none | google | osrm. Empty = google when the key below is set, else none (labelled
# straight lines). osrm = an OSRM server YOU run (docs/maps/ROUTING_PROVIDERS.md); off unless chosen.
ROUTING_PROVIDER=
OSRM_BASE_URL=
OSRM_TIMEOUT_SECONDS=8
# Server key (Routes API) for the backend. SERVER-ONLY: restrict by IP and API; never a VITE_ var.
GOOGLE_MAPS_SERVER_API_KEY=

# --- Account e-mail (password reset, e-mail verification, security notices) ---
# EMAIL_BACKEND: none | console | smtp. Empty = none in production (nothing is sent and the web
# app hides "forgot password"), console in local development (the message, including its link, is
# written to the backend log; refused in production). See docs/operations/account-recovery.md.
# Supervised demo with a visible inbox and no real provider: `make demo-mail-up` (Mailpit; it
# generates .env.demo-mail with its own throw-away SMTP credentials, so leave these blank here).
# A real provider: EMAIL_BACKEND=smtp, SMTP_SECURITY=starttls, and the provider's values below
# (supplied as secrets, never committed). Real delivery has NOT been verified in this repository.
EMAIL_BACKEND=
EMAIL_FROM=
# Public address of the web app: links in e-mails point here (https in production).
APP_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
# starttls (default) | ssl | none (none is refused in production)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
PASSWORD_RESET_TOKEN_MINUTES=30
EMAIL_VERIFICATION_TOKEN_HOURS=24
# true = sign-in needs a verified address. Needs working e-mail; run
# `python -m app.cli mark-email-verified --all-existing` first on a system that already has users.
EMAIL_VERIFICATION_REQUIRED=false

# Accounts one client address may register per hour. Keep 10 in a deployment (the CI end-to-end stack raises it).
REGISTRATION_LIMIT_PER_IP_PER_HOUR=10

# Days an idle help-assistant conversation is kept (`python -m app.cli purge-assistant-conversations`).
ASSISTANT_RETENTION_DAYS=90

# Roles that must switch on two-step verification before they can use anything else.
# Blank = the default policy (administrator and manager in production, nobody in local/test).
# A comma-separated list of roles overrides it; `none` turns it off (an owner decision).
MFA_REQUIRED_ROLES=
