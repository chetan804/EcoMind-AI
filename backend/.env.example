# EcoMind-AI backend configuration.
# Copy to backend/.env and edit. NEVER commit real secrets — .env is gitignored.

# ---- Core -------------------------------------------------------------------
# development | test | staging | production
ECOMIND_ENVIRONMENT=development
ECOMIND_API_PREFIX=/api/v1
ECOMIND_LOG_LEVEL=INFO

# ---- Security ---------------------------------------------------------------
# REQUIRED in production (app refuses to boot without it).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ECOMIND_SECRET_KEY=
ECOMIND_ACCESS_TOKEN_MINUTES=30
ECOMIND_REFRESH_TOKEN_DAYS=30
ECOMIND_PASSWORD_RESET_MINUTES=60
# Comma-separated origins, or * for development only.
ECOMIND_CORS_ORIGINS=http://localhost:5173

# ---- Database ---------------------------------------------------------------
# PostgreSQL with asyncpg. In production use TCP, e.g.:
#   postgresql+asyncpg://ecomind:PASSWORD@db:5432/ecomind
ECOMIND_DATABASE_URL=postgresql+asyncpg://postgres@/ecomind?host=/home/user/EcoMind-AI/.pgdata

# ---- File storage -----------------------------------------------------------
# Local directory under backend/. For S3-compatible object storage, mount and
# point this at the mount path (see app/core/storage.py for the abstraction).
ECOMIND_DATA_DIR=./data
ECOMIND_MAX_UPLOAD_BYTES=10485760

# ---- AI providers (all optional) ---------------------------------------------
# Without keys the platform uses the deterministic heuristic baseline and
# labels every inference is_simulated=true with human-review routing.
# No model names are hard-coded; providers are configured by name.
ECOMIND_AI_DEFAULT_PROVIDER=heuristic
ECOMIND_OPENAI_API_KEY=
ECOMIND_ANTHROPIC_API_KEY=
ECOMIND_GOOGLE_API_KEY=
ECOMIND_OPENAI_BASE_URL=https://api.openai.com/v1
ECOMIND_ANTHROPIC_BASE_URL=https://api.anthropic.com
ECOMIND_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ECOMIND_AI_REQUEST_TIMEOUT_SECONDS=45

# ---- Routing / optimisation ---------------------------------------------------
# OSRM base URL for real road geometry. Empty -> straight-line estimates with
# a documented x1.3 road factor, clearly labelled in the UI and API.
ECOMIND_OSRM_BASE_URL=
ECOMIND_ROAD_DISTANCE_FACTOR=1.3
ECOMIND_ROUTE_SYNC_MAX_STOPS=40

# ---- Background jobs ----------------------------------------------------------
# Embedded worker keeps single-container deployments simple. Set false and run
# a second app instance with ECOMIND_RUN_EMBEDDED_WORKER=false to isolate jobs.
ECOMIND_RUN_EMBEDDED_WORKER=true
ECOMIND_WORKER_POLL_SECONDS=1.0

# ---- Demo simulator (LABELLED simulation, never mixes with real data) ---------
ECOMIND_ENABLE_DEMO_SIMULATOR=false
ECOMIND_DEMO_SIMULATOR_INTERVAL_SECONDS=30

# ---- Rate limits (requests per minute) ----------------------------------------
ECOMIND_RATE_LIMIT_AUTH=15
ECOMIND_RATE_LIMIT_WRITE=60
ECOMIND_RATE_LIMIT_AI=20
ECOMIND_RATE_LIMIT_UPLOAD=30
ECOMIND_RATE_LIMIT_TELEMETRY=600
ECOMIND_RATE_LIMIT_READ=600
