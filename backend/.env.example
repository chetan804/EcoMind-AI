# EcoMind AI backend environment (used when running the backend directly on the host).
# Copy to backend/.env (`make env` does this and generates secrets). Never commit .env files.
# When running through Docker Compose, the root .env is used instead (see ../.env.example).

# local | test | production. Selects validation strictness (see docs/security/security-baseline.md).
ENVIRONMENT=local
LOG_LEVEL=INFO
# Emit one JSON object per log line (recommended outside local development).
LOG_JSON=false

# PostgreSQL connection URL, SQLAlchemy format with the psycopg v3 driver.
DATABASE_URL=postgresql+psycopg://ecomind:CHANGE_ME@localhost:5432/ecomind

# Signs access tokens. At least 32 characters; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_random_value_with_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# Refresh-token cookie: Secure must be true in production (HTTPS only).
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Comma-separated list of browser origins allowed by CORS. Never "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Uploaded media storage. "local" writes under FILE_STORAGE_LOCAL_PATH (needs a persistent volume).
FILE_STORAGE_BACKEND=local
FILE_STORAGE_LOCAL_PATH=./var/storage
MAX_UPLOAD_BYTES=10485760

# Directory containing versioned ML artifacts (see ml/model_registry/README.md).
MODEL_ARTIFACTS_DIR=../ml/artifacts

# Rewards policy: points awarded per verified kilogram collected for a reporter (0 disables).
REWARD_POINTS_PER_KG=10
# New accounts one client address may create per hour. Keep 10 in a deployment; the CI end-to-end stack raises it.
REGISTRATION_LIMIT_PER_IP_PER_HOUR=10
# Days an idle help-assistant conversation is kept before `purge-assistant-conversations` removes it.
ASSISTANT_RETENTION_DAYS=90
# Roles that must use two-step verification: blank = production default (administrator, manager),
# a comma-separated list overrides it, `none` turns it off.
MFA_REQUIRED_ROLES=
# Days a published marketplace listing stays on offer (1-90) before the daily job closes it.
MARKETPLACE_LISTING_DAYS=30

# --- Road routing (optional) ---
# Optional road routing: none | google | osrm. Empty = google when the key below is set, else none (labelled
# straight lines). osrm = an OSRM server YOU run (docs/maps/ROUTING_PROVIDERS.md); off unless chosen.
ROUTING_PROVIDER=
OSRM_BASE_URL=
OSRM_TIMEOUT_SECONDS=8

# --- Google Maps (server side) ---
# Key for the Routes API, used only by the backend to compute road routes for route plans. Keep it
# SERVER-ONLY: restrict it by this server's IP address and to the Routes API in Google Cloud, and
# never copy it into a VITE_ variable or the frontend. Empty = road routes are reported as
# unavailable and the UI shows labelled straight lines. The key is never logged or returned.
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_ROUTES_TIMEOUT_SECONDS=8

# --- Vehicle tracking policy ---
# A real-source position is LIVE up to TRACKING_LIVE_WITHIN_SECONDS old, DELAYED until
# TRACKING_STALE_AFTER_SECONDS, STALE after that.
TRACKING_LIVE_WITHIN_SECONDS=120
TRACKING_STALE_AFTER_SECONDS=900
TRACKING_MAX_FUTURE_SKEW_SECONDS=120
TRACKING_MAX_REPORT_AGE_HOURS=6
TRACKING_MAX_EVENTS_PER_MINUTE=30
# Location events older than this are removed by `python -m app.cli purge-location-events`.
TRACKING_RETENTION_DAYS=90
# Labelled demonstration positions. Default: on outside production, off in production.
# TRACKING_SIMULATOR_ENABLED=true

# --- Account e-mail (password reset, e-mail verification, security notices) ---
# EMAIL_BACKEND: none | console | smtp. Empty = none in production (nothing is sent and the web
# app hides "forgot password"), console in local development (the message, including its link, is
# written to the backend log; refused in production). See docs/operations/account-recovery.md.
EMAIL_BACKEND=
EMAIL_FROM=
# Public address of the web app: links in e-mails point here (https in production).
APP_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
# starttls (default) | ssl | none (none is refused in production)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
PASSWORD_RESET_TOKEN_MINUTES=30
EMAIL_VERIFICATION_TOKEN_HOURS=24
# true = sign-in needs a verified address. Needs working e-mail; run
# `python -m app.cli mark-email-verified --all-existing` first on a system that already has users.
EMAIL_VERIFICATION_REQUIRED=false
